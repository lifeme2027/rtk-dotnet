<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RtkFilters</RootNamespace>
    <PackageId>RtkFilters.Net</PackageId>
    <Title>RtkFilters.Net</Title>
    <Description>Unofficial .NET port of the Apache-2.0 TOML output filters from rtk-ai/rtk. Does not include BUSL-1.1 engine/ or proxy/ code.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Verbatim copies of upstream src/filters/*.toml at the commit in upstream/UPSTREAM_COMMIT -->
    <EmbeddedResource Include="..\..\upstream\filters\*.toml" LogicalName="RtkFilters.Builtin.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

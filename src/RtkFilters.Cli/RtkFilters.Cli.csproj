<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>rtk-dotnet</AssemblyName>
    <RootNamespace>RtkFilters.Cli</RootNamespace>
    <PackageId>rtk-dotnet</PackageId>
    <Title>rtk-dotnet</Title>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rtk-dotnet</ToolCommandName>
    <Description>Unofficial .NET port of rtk-ai/rtk output filters (Apache-2.0 subset; excludes BUSL-1.1 engine/proxy).</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RtkFilters\RtkFilters.csproj" />
  </ItemGroup>

</Project>
